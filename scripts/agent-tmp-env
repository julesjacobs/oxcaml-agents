#!/bin/sh
set -eu

usage() {
  echo "usage: $0 [agent-name]" >&2
  echo "prints shell exports for this agent's local helper paths" >&2
  exit 2
}

[ "$#" -le 1 ] || usage

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "$#" -eq 1 ]; then
  agent_name=$1
else
  case "$PWD/" in
    "$workspace"/agents/*/*)
      rest=${PWD#"$workspace"/agents/}
      agent_name=${rest%%/*}
      ;;
    "$workspace"/agents/*)
      rest=${PWD#"$workspace"/agents/}
      agent_name=${rest%%/*}
      ;;
    *)
      echo "cannot infer agent name from current directory: $PWD" >&2
      usage
      ;;
  esac
fi

case "$agent_name" in
  *[!A-Za-z0-9._-]*|'') usage ;;
esac

agent_dir="$workspace/agents/$agent_name"
local_root="$agent_dir"

if [ ! -d "$agent_dir/oxcaml" ]; then
  echo "not an agent checkout: $agent_dir/oxcaml" >&2
  echo "start from the workspace root with scripts/use-or-create-agent $agent_name" >&2
  exit 1
fi

mkdir -p "$local_root/tmp"

cat <<EOF
export OXCAML_AGENT_NAME='$agent_name'
export OXCAML_AGENT_DIR='$agent_dir'
export OXCAML_AGENT_TMP='$local_root'
export TMPDIR='$local_root/tmp'
export LLVM_BUILD='$local_root/llvm-build'
export LLVM_CLANG='$local_root/llvm-build/bin/clang'
export LLVM_WRAPPER='$local_root/clang-wrapper'
export LLVM_PATH='$local_root/clang-wrapper'
export LLVM_WRAPPER_LOG='$local_root/clang-wrapper.log'
export LLVM_WRAPPER_TARGET='$local_root/clang-wrapper.target'
export FAKE_ROOT='$local_root/ocamltest-src'
export LIST='$local_root/all-minus-asm-list.txt'
EOF

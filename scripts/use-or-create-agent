#!/bin/sh
set -eu

usage() {
  echo "usage: $0 <agent-name>" >&2
  echo "example: $0 tail-calls" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage

agent_name=$1

case "$agent_name" in
  *[!A-Za-z0-9._-]*|'') usage ;;
esac

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
agent_dir="$workspace/agents/$agent_name"
state_rel="agent-state/$agent_name"
state_dir="$agent_dir/oxcaml/$state_rel"
base_branch="jujacobs/llvm-backend-integration"
repo="julesjacobs/oxcaml"

print_agent_paths() {
  dir=$1
  name=$2

  if [ ! -d "$dir/oxcaml" ]; then
    echo "agent exists but has no OxCaml checkout: $dir/oxcaml" >&2
    return 1
  fi

  if ! git -C "$dir/oxcaml" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "agent checkout is not a git worktree: $dir/oxcaml" >&2
    return 1
  fi

  top=$(git -C "$dir/oxcaml" rev-parse --show-toplevel)
  top_real=$(CDPATH= cd -- "$top" && pwd -P)
  oxcaml_real=$(CDPATH= cd -- "$dir/oxcaml" && pwd -P)
  if [ "$top_real" != "$oxcaml_real" ]; then
    echo "agent checkout is inside another git repo, not its own worktree: $dir/oxcaml" >&2
    echo "git top-level: $top_real" >&2
    return 1
  fi

  branch=$(git -C "$dir/oxcaml" branch --show-current 2>/dev/null || true)

  echo "using existing $dir"
  echo "Code checkout: $dir/oxcaml"
  if [ -n "$branch" ]; then
    echo "Branch: $branch"
  fi

  expected_state="$dir/oxcaml/agent-state/$name"
  if [ -d "$expected_state" ]; then
    echo "State: $expected_state"
    [ -e "$expected_state/GOAL.md" ] && echo "Goal: $expected_state/GOAL.md" || echo "Goal: missing $expected_state/GOAL.md" >&2
    [ -e "$expected_state/PROGRESS.md" ] && echo "Progress: $expected_state/PROGRESS.md" || echo "Progress: missing $expected_state/PROGRESS.md" >&2
  else
    found_state=$(find "$dir/oxcaml/agent-state" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | sed -n '1p' || true)
    if [ -n "$found_state" ]; then
      echo "State: $found_state"
      echo "warning: state directory does not match agent name '$name'" >&2
      [ -e "$found_state/GOAL.md" ] && echo "Goal: $found_state/GOAL.md" || echo "Goal: missing $found_state/GOAL.md" >&2
      [ -e "$found_state/PROGRESS.md" ] && echo "Progress: $found_state/PROGRESS.md" || echo "Progress: missing $found_state/PROGRESS.md" >&2
    else
      echo "State: missing $expected_state" >&2
    fi
  fi

  echo "LLVM build: $dir/llvm-build"
  echo "LLVM clang: $dir/llvm-build/bin/clang"
  echo "LLVM wrapper: $dir/clang-wrapper"
}

write_agent_instructions() {
  dir=$1
  state=$2

  cat > "$dir/AGENTS.md" <<EOF
# Agent Instructions

Work in \`oxcaml/\`.

Use the workspace instructions at \`../../AGENTS.md\` for shared rules. This
agent's current handoff state is in \`oxcaml/$state/\`.

The private local LLVM paths for this agent are:

- LLVM build: \`llvm-build/\`
- clang: \`llvm-build/bin/clang\`
- optional wrapper: \`clang-wrapper\`
- wrapper target: \`clang-wrapper.target\`
- wrapper log: \`clang-wrapper.log\`

Before LLVM-backend builds, configure the checkout from the workspace root with
\`scripts/configure-agent-oxcaml --clean <agent-name>\`, or with
\`../../../scripts/configure-agent-oxcaml --clean\` from inside \`oxcaml/\`.
This uses a local \`_install\` prefix and enables frame pointers.

Build the native stage-0 compiler from \`oxcaml/\` with:

\`\`\`sh
make _install LLVM_BOOT_BACKEND=0 LLVM_BACKEND=0 OCAMLPARAM= BUILD_OCAMLPARAM=
\`\`\`

From \`oxcaml/\`, pass \`LLVM_PATH=\$PWD/../llvm-build/bin/clang\` to commands
that need the custom clang. If wrapper logs are needed, run
\`../../../scripts/write-agent-clang-wrapper ../llvm-build/bin/clang\`, then
pass \`LLVM_PATH=\$PWD/../clang-wrapper\`.

For self-stage repros, prefer:

\`\`\`sh
STAGE0_INSTALL="\$PWD/_install" LLVM_WRAPPER="\$PWD/../clang-wrapper" tools/build-llvm-self-stage-install.sh
\`\`\`

After any long build or failed repro, run \`../../../scripts/agent-doctor\`
before handing off. It checks branch shape, local prefix, frame pointers, the
installed stdlib path, and the private LLVM wrapper target.
EOF
}

if [ -e "$agent_dir" ]; then
  if [ ! -d "$agent_dir" ]; then
    echo "agent path exists but is not a directory: $agent_dir" >&2
    exit 1
  fi
  print_agent_paths "$agent_dir" "$agent_name"
  exit 0
fi

ox_branch="jujacobs/$agent_name"
today=$(date +%F)

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is required to create the draft PR" >&2
  exit 1
fi

gh auth status >/dev/null

if [ ! -d "$workspace/main/oxcaml/vendor/llvm-project" ]; then
  echo "warning: main/oxcaml/vendor/llvm-project does not exist yet" >&2
  echo "run scripts/import-vendored-llvm after the vendored LLVM baseline is ready" >&2
fi

if [ -z "$(git -C "$workspace/main/oxcaml" ls-tree -d --name-only \
  "$base_branch" vendor/llvm-project)" ]; then
  echo "vendored LLVM is not committed on $base_branch" >&2
  echo "commit the vendor/llvm-project baseline before creating agents" >&2
  exit 1
fi

origin_url=$(git -C "$workspace/main/oxcaml" remote get-url --push origin)
case "$origin_url" in
  *github.com/julesjacobs/oxcaml.git|*github.com:julesjacobs/oxcaml.git) ;;
  *)
    echo "main/oxcaml origin must push to Jules's fork, got: $origin_url" >&2
    exit 1
    ;;
esac

mkdir -p "$agent_dir"

git -C "$workspace/main/oxcaml" worktree add -b "$ox_branch" \
  "$agent_dir/oxcaml" "$base_branch"

mkdir -p "$state_dir"

cat > "$state_dir/GOAL.md" <<EOF
# Goal

Describe the concrete goal for this agent.

## Scope

- Primary repo: OxCaml monorepo at \`oxcaml/\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
- Expected output: TBD

## Branches

- OxCaml: \`$ox_branch\`

## Pull Requests

- OxCaml PR: pending
EOF

cat > "$state_dir/PROGRESS.md" <<EOF
# Progress

Last updated: $today.

## Current Claim

Fresh agent workspace created. No claim yet.

## Evidence

- OxCaml branch: \`$ox_branch\`
- OxCaml PR: pending
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
- Agent state path: \`$state_rel\`

## Current Blocker

Fill in \`$state_rel/GOAL.md\`.

## Next Step

Define the goal, then make the smallest focused change or reproducer.
EOF

git -C "$agent_dir/oxcaml" add "$state_rel/GOAL.md" "$state_rel/PROGRESS.md"
git -C "$agent_dir/oxcaml" commit -m "Start agent $agent_name"
git -C "$agent_dir/oxcaml" push -u origin "$ox_branch"

pr_body=$(mktemp)
trap 'rm -f "$pr_body"' EXIT
cat > "$pr_body" <<EOF
Goal:
TBD.

Current state:
- Agent workspace created at \`agents/$agent_name/\`.
- Agent state is tracked in this branch under \`$state_rel/\`.
- No code changes yet.

Notes:
- OxCaml branch: \`$ox_branch\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
EOF

pr_url=$(gh pr create \
  --repo "$repo" \
  --base "$base_branch" \
  --head "$ox_branch" \
  --draft \
  --title "Agent: $agent_name" \
  --body-file "$pr_body")

cat > "$state_dir/GOAL.md" <<EOF
# Goal

Describe the concrete goal for this agent.

## Scope

- Primary repo: OxCaml monorepo at \`oxcaml/\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
- Expected output: TBD

## Branches

- OxCaml: \`$ox_branch\`

## Pull Requests

- OxCaml PR: $pr_url
EOF

cat > "$state_dir/PROGRESS.md" <<EOF
# Progress

Last updated: $today.

## Current Claim

Fresh agent workspace created. No claim yet.

## Evidence

- OxCaml branch: \`$ox_branch\`
- OxCaml PR: $pr_url
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
- Agent state path: \`$state_rel\`

## Current Blocker

Fill in \`$state_rel/GOAL.md\`.

## Next Step

Define the goal, then make the smallest focused change or reproducer.
EOF

git -C "$agent_dir/oxcaml" add "$state_rel/GOAL.md" "$state_rel/PROGRESS.md"
git -C "$agent_dir/oxcaml" commit --amend --no-edit
git -C "$agent_dir/oxcaml" push --force-with-lease

write_agent_instructions "$agent_dir" "$state_rel"

echo "created $agent_dir"
echo "OxCaml branch: $ox_branch"
echo "OxCaml PR: $pr_url"
echo "Goal: $state_dir/GOAL.md"
echo "Progress: $state_dir/PROGRESS.md"
echo "Vendored LLVM path: $agent_dir/oxcaml/vendor/llvm-project"
echo "LLVM build: $agent_dir/llvm-build"
echo "LLVM clang: $agent_dir/llvm-build/bin/clang"
echo "LLVM wrapper: $agent_dir/clang-wrapper"

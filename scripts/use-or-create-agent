#!/bin/sh
set -eu

usage() {
  echo "usage: $0 <agent-name>" >&2
  echo "example: $0 tail-calls" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage

agent_name=$1

case "$agent_name" in
  *[!A-Za-z0-9._-]*|'') usage ;;
esac

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
agent_dir="$workspace/agents/$agent_name"
base_branch="jujacobs/llvm-backend-integration"
repo="julesjacobs/oxcaml"

if [ -e "$agent_dir" ]; then
  if [ ! -d "$agent_dir" ]; then
    echo "agent path exists but is not a directory: $agent_dir" >&2
    exit 1
  fi
  echo "using existing $agent_dir"
  echo "Code checkout: $agent_dir/oxcaml"
  echo "Goal: $agent_dir/GOAL.md"
  echo "Progress: $agent_dir/PROGRESS.md"
  exit 0
fi

ox_branch="jujacobs/$agent_name"
today=$(date +%F)

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is required to create the draft PR" >&2
  exit 1
fi

gh auth status >/dev/null

if [ ! -d "$workspace/main/oxcaml/vendor/llvm-project" ]; then
  echo "warning: main/oxcaml/vendor/llvm-project does not exist yet" >&2
  echo "run scripts/import-vendored-llvm after the vendored LLVM baseline is ready" >&2
fi

if [ -z "$(git -C "$workspace/main/oxcaml" ls-tree -d --name-only \
  "$base_branch" vendor/llvm-project)" ]; then
  echo "vendored LLVM is not committed on $base_branch" >&2
  echo "commit the vendor/llvm-project baseline before creating agents" >&2
  exit 1
fi

origin_url=$(git -C "$workspace/main/oxcaml" remote get-url --push origin)
case "$origin_url" in
  *github.com/julesjacobs/oxcaml.git|*github.com:julesjacobs/oxcaml.git) ;;
  *)
    echo "main/oxcaml origin must push to Jules's fork, got: $origin_url" >&2
    exit 1
    ;;
esac

mkdir -p "$agent_dir"

git -C "$workspace/main/oxcaml" worktree add -b "$ox_branch" \
  "$agent_dir/oxcaml" "$base_branch"

git -C "$agent_dir/oxcaml" commit --allow-empty -m "Start agent $agent_name"
git -C "$agent_dir/oxcaml" push -u origin "$ox_branch"

pr_body=$(mktemp)
trap 'rm -f "$pr_body"' EXIT
cat > "$pr_body" <<EOF
Goal:
TBD.

Current state:
- Agent workspace created at \`agents/$agent_name/\`.
- No code changes yet.

Notes:
- OxCaml branch: \`$ox_branch\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
EOF

pr_url=$(gh pr create \
  --repo "$repo" \
  --base "$base_branch" \
  --head "$ox_branch" \
  --draft \
  --title "Agent: $agent_name" \
  --body-file "$pr_body")

cat > "$agent_dir/GOAL.md" <<EOF
# Goal

Describe the concrete goal for this agent.

## Scope

- Primary repo: OxCaml monorepo at \`oxcaml/\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`
- Expected output: TBD

## Branches

- OxCaml: \`$ox_branch\`

## Pull Requests

- OxCaml PR: $pr_url
EOF

cat > "$agent_dir/PROGRESS.md" <<EOF
# Progress

Last updated: $today.

## Current Claim

Fresh agent workspace created. No claim yet.

## Evidence

- OxCaml branch: \`$ox_branch\`
- OxCaml PR: $pr_url
- Initial PR commit: \`$(git -C "$agent_dir/oxcaml" rev-parse --short=12 HEAD)\`
- Vendored LLVM path: \`oxcaml/vendor/llvm-project\`

## Current Blocker

Fill in \`GOAL.md\`.

## Next Step

Define the goal, then make the smallest focused change or reproducer.
EOF

cat > "$agent_dir/AGENTS.md" <<EOF
# Agent Instructions

Follow \`GOAL.md\`.

This directory is \`agents/$agent_name/\`. The code checkout is \`oxcaml/\`.
Handoff notes for this task go in \`PROGRESS.md\`.

Keep \`PROGRESS.md\` compact: current claim, evidence, current blocker, next
step, branches, commits, and PR links.

Commit real code or test progress. Do not commit progress-note-only changes
unless they are part of the same commit as a real change.

Push agent branches to Jules's \`julesjacobs/oxcaml\` fork. Use
\`julesjacobs/llvm-project\` only for maintaining the LLVM import-source
checkout or when explicitly requested. Do not push to upstream repositories.

Before acting on GitHub review comments, verify that the comment is correct.

Avoid running multiple \`make\` or \`dune\` commands at the same time in the
same checkout.

When a nested repo \`AGENTS.md\` says to test or format, do it only when it
makes sense for the current step. Full tests can take a long time, so avoid
running them while still reducing or investigating a failure. If an instruction
says to use \`-s\`, skip \`-s\` when command output is needed for debugging.

When testing LLVM-backend behavior, verify real LLVM use by checking
\`/tmp/oxcaml-clang-wrapper.log\` for \`-x ir\` and the fixed-register flags.

Do not treat the historical \`stage4\`/\`stage5\` script names as conceptual
validation stages. During normal work, iterate with the standard installed
compiler and \`-llvm-backend\`. Use self-stage2 for full validation unless
\`GOAL.md\` says otherwise.

If a self-stage or stage2 failure appears, first try to reduce it to a focused
test case that already fails with the standard compiler using \`-llvm-backend\`.
If it only reproduces with self-stage2, record the smallest self-stage2
reproducer and why the standard \`-llvm-backend\` compiler does not cover it.
EOF

echo "created $agent_dir"
echo "OxCaml branch: $ox_branch"
echo "OxCaml PR: $pr_url"
echo "Vendored LLVM path: $agent_dir/oxcaml/vendor/llvm-project"
